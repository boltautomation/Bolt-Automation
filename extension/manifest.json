{
  "manifest_version": 3,
  "name": "ChatterHigh Quiz Bot",
  "version": "1.0.0",
  "description": "Research and complete Daily Quiz and Mindful Module questions in your signed-in tab.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://chatterhigh.com/*", "https://www.chatterhigh.com/*", "https://api.openai.com/*"],
  "action": { "default_title": "Open ChatterHigh Quiz Bot" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatterhigh.com/*", "https://www.chatterhigh.com/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
