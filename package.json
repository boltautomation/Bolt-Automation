{
  "name": "bolt",
  "version": "2.0.0",
  "private": true,
  "description": "Local study workspace with PDF research and verified answers",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Build-Bolt.ps1",
    "package:macos": "node tools/Build-Bolt-Mac.cjs",
    "start:browser": "node app/server.cjs --open",
    "package:desktop": "node tools/Build-Bolt-Desktop.cjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boltautomation/Bolt-Automation.git"
  },
  "homepage": "https://github.com/boltautomation/Bolt-Automation#readme",
  "versionName": "V2 - Hemlock",
  "releaseTag": "v2-hemlock",
  "artifacts": {
    "windows": "Bolt-v2-hemlock-Windows-x64.zip",
    "arm64": "Bolt-v2-hemlock-macOS-arm64.zip",
    "x64": "Bolt-v2-hemlock-macOS-x64.zip"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.4.1"
  },
  "main": "app/desktop-main.cjs",
  "productName": "Bolt"
}
